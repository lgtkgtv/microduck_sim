<mujoco model="microduck">
  <compiler angle="radian"/>

  <default>
    <!-- Default physics for all joints and motors -->
    <joint damping="0.1" armature="0.01"/>
    <!-- The hardware clamp: max motor velocity/torque limits -->
    <motor ctrlrange="-1.0 1.0" ctrllimited="true"/> 
    <geom rgba="1.0 0.8 0.2 1" density="1000"/>
  </default>

  <worldbody>
    <!-- The Floor -->
    <geom type="plane" size="2 2 0.1" pos="0 0 -0.25" rgba="0.9 0.9 0.9 1"/>

    <!-- The Microduck Pelvis (Root Body) floating 25cm high -->
    <body name="pelvis" pos="0 0 0.25">
      <joint type="free" name="root"/>
      <geom type="box" size="0.04 0.05 0.03" rgba="1 0.8 0.2 1" mass="0.3"/>

      <!-- Left Leg (5 DOFs) -->
      <body name="l_hip_yaw_link" pos="0.02 0.03 -0.02">
        <joint name="l_hip_yaw" type="hinge" axis="0 0 1"/>
        <geom type="cylinder" size="0.012 0.01" mass="0.03"/>
        <body name="l_hip_roll_link" pos="0 0.02 0">
          <joint name="l_hip_roll" type="hinge" axis="1 0 0"/>
          <geom type="cylinder" size="0.012 0.01" mass="0.03"/>
          <body name="l_hip_pitch_link" pos="0 0 -0.03">
            <joint name="l_hip_pitch" type="hinge" axis="0 1 0"/>
            <geom type="capsule" size="0.01 0.03" mass="0.04"/>
            <body name="l_knee_link" pos="0 0 -0.06">
              <joint name="l_knee_pitch" type="hinge" axis="0 1 0"/>
              <geom type="capsule" size="0.009 0.03" mass="0.03"/>
              <body name="l_foot_link" pos="0 0 -0.06">
                <joint name="l_ankle_pitch" type="hinge" axis="0 1 0"/>
                <geom type="box" size="0.03 0.02 0.008" rgba="0.95 0.45 0.1 1" mass="0.04"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- Right Leg (5 DOFs) -->
      <body name="r_hip_yaw_link" pos="0.02 -0.03 -0.02">
        <joint name="r_hip_yaw" type="hinge" axis="0 0 1"/>
        <geom type="cylinder" size="0.012 0.01" mass="0.03"/>
        <body name="r_hip_roll_link" pos="0 -0.02 0">
          <joint name="r_hip_roll" type="hinge" axis="1 0 0"/>
          <geom type="cylinder" size="0.012 0.01" mass="0.03"/>
          <body name="r_hip_pitch_link" pos="0 0 -0.03">
            <joint name="r_hip_pitch" type="hinge" axis="0 1 0"/>
            <geom type="capsule" size="0.01 0.03" mass="0.04"/>
            <body name="r_knee_link" pos="0 0 -0.06">
              <joint name="r_knee_pitch" type="hinge" axis="0 1 0"/>
              <geom type="capsule" size="0.009 0.03" mass="0.03"/>
              <body name="r_foot_link" pos="0 0 -0.06">
                <joint name="r_ankle_pitch" type="hinge" axis="0 1 0"/>
                <geom type="box" size="0.03 0.02 0.008" rgba="0.95 0.45 0.1 1" mass="0.04"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- Neck & Head (5 DOFs) -->
      <body name="neck_base" pos="0.03 0 0.04">
        <joint name="neck_yaw" type="hinge" axis="0 0 1"/>
        <geom type="cylinder" size="0.012 0.01" mass="0.02"/>
        <body name="neck_mid" pos="0 0 0.02">
          <joint name="neck_pitch" type="hinge" axis="0 1 0"/>
          <geom type="capsule" size="0.012 0.02" mass="0.03"/>
          <body name="neck_top" pos="0 0 0.04">
            <joint name="neck_roll" type="hinge" axis="1 0 0"/>
            <geom type="cylinder" size="0.01 0.01" mass="0.02"/>
            <body name="head_yaw_link" pos="0 0 0.02">
              <joint name="head_yaw" type="hinge" axis="0 0 1"/>
              <geom type="cylinder" size="0.01 0.01" mass="0.02"/>
              <body name="head_main" pos="0.01 0 0.03">
                <joint name="head_pitch" type="hinge" axis="0 1 0"/>
                <geom type="sphere" size="0.035" rgba="1 0.85 0.1 1" mass="0.15"/>
                <geom type="box" size="0.018 0.012 0.006" pos="0.03 0 -0.01" rgba="0.95 0.45 0.1 1" mass="0.02"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Left Leg (5 Motors) -->
    <motor joint="l_hip_yaw" name="motor_l0"/>
    <motor joint="l_hip_roll" name="motor_l1"/>
    <motor joint="l_hip_pitch" name="motor_l2"/>
    <motor joint="l_knee_pitch" name="motor_l3"/>
    <motor joint="l_ankle_pitch" name="motor_l4"/>
    <!-- Right Leg (5 Motors) -->
    <motor joint="r_hip_yaw" name="motor_r5"/>
    <motor joint="r_hip_roll" name="motor_r6"/>
    <motor joint="r_hip_pitch" name="motor_r7"/>
    <motor joint="r_knee_pitch" name="motor_r8"/>
    <motor joint="r_ankle_pitch" name="motor_r9"/>
    <!-- Neck & Head (5 Motors) -->
    <motor joint="neck_yaw" name="motor_n10"/>
    <motor joint="neck_pitch" name="motor_n11"/>
    <motor joint="neck_roll" name="motor_n12"/>
    <motor joint="head_yaw" name="motor_n13"/>
    <motor joint="head_pitch" name="motor_n14"/>
  </actuator>
</mujoco>
